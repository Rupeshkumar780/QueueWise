generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(CUSTOMER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  businesses   Business[]
  queueEntries QueueEntry[]
  staffAt      Business[]   @relation("BusinessStaff")
}

model Business {
  id             String    @id @default(uuid())
  name           String
  description    String?
  ownerId        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  address        String?
  city           String
  geofenceRadius Int       @default(200)
  googleMapsUrl  String?
  isOpen         Boolean   @default(true)
  latitude       Float?
  longitude      Float?
  timezone       String    @default("UTC")
  owner          User      @relation(fields: [ownerId], references: [id])
  counters       Counter[]
  queues         Queue[]
  services       Service[]
  staff          User[]    @relation("BusinessStaff")
}

model Service {
  id                 String        @id @default(uuid())
  name               String
  description        String?
  estimatedDuration  Int           @default(15)
  requiresLocation   Boolean       @default(false)
  priorityEnabled    Boolean       @default(false)
  appointmentEnabled Boolean       @default(false)
  active             Boolean       @default(true)
  businessId         String
  formTemplate       FormTemplate?
  queues             Queue[]
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Queue {
  id               String       @id @default(uuid())
  serviceId        String
  name             String
  status           QueueStatus  @default(OPEN)
  currentToken     Int          @default(0)
  tokenPrefix      String?
  maxCapacity      Int?
  locationRadius   Int?
  locationRequired Boolean      @default(false)
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service          Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  entries          QueueEntry[]
}

model Counter {
  id                  String        @id @default(uuid())
  name                String
  status              CounterStatus @default(OFFLINE)
  supportedServices   String[]
  currentQueueEntryId String?
  businessId          String
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model QueueEntry {
  id                 String      @id @default(uuid())
  queueId            String
  userId             String?
  tokenNumber        Int
  status             EntryStatus @default(WAITING)
  priority           Int         @default(0)
  priorityReason     String?
  joinedAt           DateTime    @default(now())
  calledAt           DateTime?
  serviceStartedAt   DateTime?
  completedAt        DateTime?
  estimatedWait      Int?
  actualWait         Int?
  serviceDuration    Int?
  assignedCounterId  String?
  locationLat        Float?
  locationLng        Float?
  locationAccuracy   Float?
  locationVerifiedAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  formData           Json?
  queue              Queue       @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user               User?       @relation(fields: [userId], references: [id])

  @@index([queueId, status])
  @@index([queueId, tokenNumber])
  @@index([userId, status])
  @@index([queueId, priority, joinedAt])
}

model FormTemplate {
  id        String   @id @default(uuid())
  serviceId String   @unique
  schema    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  BUSINESS_ADMIN
  STAFF
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

enum CounterStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum EntryStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  NO_SHOW
  TRANSFERRED
}
