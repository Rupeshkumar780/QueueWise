datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// User Identity & RBAC
model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  businesses   Business[]
  queueEntries QueueEntry[]
}

enum Role {
  CUSTOMER
  BUSINESS_ADMIN
  STAFF
}

// Core Domain
model Business {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  
  // Location details (formerly Branch)
  address           String?
  city              String   @default("Delhi")
  latitude          Float?
  longitude         Float?
  geofenceRadius    Int      @default(100)
  googleMapsUrl     String?
  isOpen            Boolean  @default(true)
  timezone          String   @default("UTC")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services   Service[]
  queues     Queue[]
  counters   Counter[]
}

model Service {
  id                  String   @id @default(uuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  estimatedDuration   Int      @default(15) // in minutes
  requiresLocation    Boolean  @default(false)
  priorityEnabled     Boolean  @default(false)
  appointmentEnabled  Boolean  @default(false)
  active              Boolean  @default(true)
  
  queues              Queue[]
  formTemplate        FormTemplate?
}

model Queue {
  id               String   @id @default(uuid())
  businessId       String
  serviceId        String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name             String
  status           QueueStatus @default(OPEN)
  currentToken     Int      @default(0)
  tokenPrefix      String?
  maxCapacity      Int?
  locationRadius   Int?
  locationRequired Boolean  @default(false)

  entries          QueueEntry[]
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

model Counter {
  id                  String   @id @default(uuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  status              CounterStatus @default(OFFLINE)
  supportedServices   String[] // Array of service IDs
  currentQueueEntryId String?
}

enum CounterStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

model QueueEntry {
  id                  String   @id @default(uuid())
  queueId             String
  userId              String?
  user                User?    @relation(fields: [userId], references: [id])
  queue               Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  tokenNumber         Int
  status              EntryStatus @default(WAITING)
  priority            Int      @default(0)
  priorityReason      String?
  
  joinedAt            DateTime @default(now())
  calledAt            DateTime?
  serviceStartedAt    DateTime?
  completedAt         DateTime?
  
  estimatedWait       Int?     // in minutes
  actualWait          Int?     // in minutes
  serviceDuration     Int?     // in minutes
  assignedCounterId   String?
  
  locationLat         Float?
  locationLng         Float?
  locationAccuracy    Float?
  locationVerifiedAt  DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  formData            Json?    // User's answers to the custom form
  
  @@index([queueId, status])
  @@index([queueId, tokenNumber])
  @@index([userId, status])
  @@index([queueId, priority, joinedAt])
}

enum EntryStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  NO_SHOW
  TRANSFERRED
}

model FormTemplate {
  id        String   @id @default(uuid())
  serviceId String   @unique
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  schema    Json     // Defines fields: type, label, required, options
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
